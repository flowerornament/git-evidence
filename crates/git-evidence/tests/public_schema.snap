verdicts: run TEXT, key TEXT, status TEXT, duration_ms REAL, cpu_ms REAL, tries INTEGER, contradicted INT
outcomes: run TEXT, key TEXT, outcome TEXT, status TEXT, reason TEXT, detail TEXT, location TEXT, contradicted INT
facts: landing INTEGER, file TEXT, pointer TEXT, before TEXT, after TEXT, check_key TEXT, checked TEXT

