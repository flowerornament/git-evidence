# The public SQL views, one section per schema version: appended, never
# edited. Checked by tests/contract.rs.

## schema 1
about: schema_version INT, views_version INT, trunk_ref TEXT, trunk TEXT, public_views TEXT, pending_views TEXT
landings: pos INTEGER, commit_id TEXT, tree TEXT, date TEXT, subject TEXT
